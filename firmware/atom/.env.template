# ============================================================
#  AtomS3 ファームウェア 設定テンプレート
#  このファイルを .env にコピーして実際の値を入力してください。
#  .env は .gitignore により Git に含まれません。
# ============================================================

# ---- Wi-Fi ----

# 接続するWi-FiのSSID（ネットワーク名）
WIFI_SSID=your_wifi_ssid

# Wi-Fiのパスワード
WIFI_PASSWORD=your_wifi_password

# ---- 固定IP設定（任意） ----
# WIFI_STATIC_IP を指定すると、その固定IPで接続します。
# 空のまま（またはコメントアウト）にすると DHCP で自動取得します。
#
# WIFI_STATIC_IP : このデバイスに割り当てる固定IPアドレス
# WIFI_GATEWAY   : ルーターのIPアドレス（デフォルトゲートウェイ）
# WIFI_SUBNET    : サブネットマスク（未指定時は 255.255.255.0）
# WIFI_DNS       : DNSサーバー（未指定時はゲートウェイを使用）
#
# 例) 192.168.1.50 を固定IPにする場合:
#   WIFI_STATIC_IP=192.168.1.50
#   WIFI_GATEWAY=192.168.1.1
#   WIFI_SUBNET=255.255.255.0
#   WIFI_DNS=192.168.1.1
WIFI_STATIC_IP=
WIFI_GATEWAY=
WIFI_SUBNET=
WIFI_DNS=

# ---- バックエンドサーバー ----

# バックエンドAPIサーバーのベースURL
# ホスト名.local 形式（mDNS）を推奨 — DHCPでIPが変わっても自動解決されます
# ホスト名の確認: Windows/Mac/Linux いずれも "hostname" コマンドで確認できます
# 例) hostname が "mypc" なら → http://mypc.local:8000
# IPアドレスを直接指定することも可能: http://192.168.1.10:8000
HOST_BASE_URL=http://your-pc-hostname.local:8000

# ---- デバイス識別 ----

# このデバイスの識別子。ホスト側の device_profiles.json でこの ID に
# ペルソナ（性格）・声色・会話履歴を割り当てます。
# 複数台で会話させる場合は機体ごとに別の値にしてください。
# 例) 1台目: atoms3-001 / 2台目: atoms3-002 / 3台目: atoms3-003
DEVICE_ID=atoms3-001

# ---- スピーカー ----

# 再生音量 (0-255)。大きいほど音量大。未指定時は 100。
# 例) もっと小さく: 60 / もっと大きく: 160
SPEAKER_VOLUME=100

# ---- オウム返しモード ----

# 声とみなす音量の下限（100ms ごとの RMS）。未指定時は 400。
# 静かな部屋で勝手に言い返すなら上げる（例 800）、話しても反応しないなら下げる（例 250）。
# シリアルモニターの "[parrot] rms=... threshold=..." を見ながら調整できます。
PARROT_MIN_RMS=400
