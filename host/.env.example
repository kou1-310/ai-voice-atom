AI_VOICE_ATOM_DEVICE_ID=atoms3-001
AI_VOICE_ATOM_DEFAULT_MODE=web
AI_VOICE_ATOM_HOST=0.0.0.0
AI_VOICE_ATOM_PORT=8000
AI_VOICE_ATOM_LLM_BASE_URL=http://localhost:11434/v1
AI_VOICE_ATOM_LLM_API_KEY=dummy
AI_VOICE_ATOM_LLM_MODEL=gpt-compatible-model
AI_VOICE_ATOM_LLM_TIMEOUT=30
# reasoning型モデルの思考出力を抑止しcontentを確実に埋める（空にすると無効）
AI_VOICE_ATOM_LLM_REASONING_EFFORT=none
# LLM応答の最大トークン数。音声会話用途に合わせ短め。長文が欲しい場合は増やす。
AI_VOICE_ATOM_LLM_MAX_TOKENS=512
# LLMへ渡すsystemプロンプト。未設定なら音声会話向けの既定値（短く口語で返す）を使う。
# 空文字を設定するとsystemを送らない。独自の指示で上書きしたい場合に設定する。
# AI_VOICE_ATOM_LLM_SYSTEM_PROMPT=あなたは音声で会話するアシスタントです。1〜2文で短く答えてください。
# 対話ガイダンス。system プロンプト末尾に連結し、相手の発言の逐語コピー（小型モデルで顕著な
# エコー崩壊）を防いで毎ターン会話を前に進めさせる。未設定なら既定、空文字で無効化。
# AI_VOICE_ATOM_LLM_DIALOGUE_GUIDANCE=
# 生成の多様性・反復抑制。小型モデル(例: Qwen3:1.7B)が相手の発言をそのまま繰り返すのを防ぐ。
# 空文字を設定するとそのパラメータを送らず、バックエンド既定に従う。
AI_VOICE_ATOM_LLM_TEMPERATURE=0.8
AI_VOICE_ATOM_LLM_PRESENCE_PENALTY=0.5
AI_VOICE_ATOM_LLM_FREQUENCY_PENALTY=0.4
AI_VOICE_ATOM_IRODORI_ROOT=third_party/irodori-tts
AI_VOICE_ATOM_TTS_TIMEOUT=120
# 常駐TTSサイドカー。モデルを常駐させ毎回のモデル再ロード(約13秒)を排除する。
# 初回のTTS要求時にirodori venv上で自動起動する。空にすると毎回infer.pyをsubprocess実行。
AI_VOICE_ATOM_TTS_SERVER_URL=http://127.0.0.1:8770
AI_VOICE_ATOM_TTS_SERVER_AUTOSTART=true
# TTSサイドカーの推論精度。既定 fp32（高精度）。bf16 にすると GPU の VRAM/演算が約半減し、
# 画面描画とのGPU競合が和らぐ（PCの重さ対策）。音質はわずかに変わりうるので既定は fp32。
# CPUデバイスでは fp32 固定（bf16指定時は自動でfp32へ退避）。
AI_VOICE_ATOM_TTS_PRECISION=fp32
# TTSの実行デバイス上書き（例: cuda / cpu）。空なら自動（cuda優先）。
AI_VOICE_ATOM_TTS_DEVICE=
# TTSサイドカーの torch CPU スレッド上限。空なら制限なし（全コア）。CPU全コア張り付きで
# OS/デスクトップが重くなるのを避けたいとき、例えば12コア中8に絞る。GPU推論時のデータ準備にも効く。
AI_VOICE_ATOM_TTS_TORCH_THREADS=
# 話者リファレンス音声の置き場所。ここにwavを置くとその声色で合成する（無ければ既定の声）。
# 相対パスはリポジトリルート基準。実行のたびに存在確認するので差し替えに再起動は不要。
AI_VOICE_ATOM_TTS_REF_WAV=host/voices/reference.wav
# 複数デバイスを別個のAI（別ペルソナ・別声色）として動かすための割り当て定義（JSON）。
# device_id ごとに system プロンプトと ref_wav を指定する。host/device_profiles.example.json を
# device_profiles.json にコピーして編集する。ファイルが無ければ全デバイスが上記グローバル設定で動く。
# 相対パスはリポジトリルート基準。
AI_VOICE_ATOM_DEVICE_PROFILES=host/device_profiles.json
# リレー会話で play を push してからデバイスの played ack を待つ上限秒数。
# 合成(GPU 競合で遅延しうる)＋再生の合計がこれを超えると会話を打ち切る。負荷が高い環境では
# 大きめにする。デバイス側 /api/chat/say のタイムアウトより長く取ること。
AI_VOICE_ATOM_RELAY_ACK_TIMEOUT=180
AI_VOICE_ATOM_MOONSHINE_ROOT=third_party/moonshine
AI_VOICE_ATOM_STT_LANGUAGE=ja
# 設定すると audio.end ごとに受信 PCM を WAV 保存する（デバイスから届いた音声の診断用）。
# 空なら無効。本番では空のままにする。
AI_VOICE_ATOM_STT_DEBUG_DIR=
# STT に渡す前に末尾を切り落とすミリ秒。停止ボタンのクリック音を除くため。
# クリック音が残るなら増やし、語尾が切れるなら減らす。0 で無効。
AI_VOICE_ATOM_STT_TRIM_TAIL_MS=250
AI_VOICE_ATOM_INCLUDE_AUDIO_INLINE=false
AI_VOICE_ATOM_RESPONSE_PREFIX=MVP 応答
# 会話履歴: session_id単位で直近N往復を保持しLLMへ渡す。0で無効。
AI_VOICE_ATOM_HISTORY_MAX_TURNS=6
# 履歴の有効期限（秒）。最終更新からこの時間を過ぎたセッションは破棄する。0で無期限。
AI_VOICE_ATOM_HISTORY_TTL_SEC=1800